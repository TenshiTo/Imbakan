                video.duration > 2
            ){

                const offset =
                    (
                        index *
                        1.79
                    )
                    %
                    video.duration;


                try{

                    video.currentTime =
                        offset;

                }

                catch(error){}

            }

        }
    );

});



/* =========================================================
   START BUTTON

   THIS CLICK IS THE IMPORTANT PART.

   Because the user deliberately clicks a button,
   browsers are much more willing to allow audible
   media playback.
========================================================= */

enterButton.addEventListener(
    "click",
    startIncident
);



function startIncident(){

    if(incidentStarted){
        return;
    }


    incidentStarted = true;



    /* =====================================================
       START BIRTHDAY MUSIC
    ===================================================== */

    birthdayMusic
        .play()
        .catch(error => {

            console.log(
                "Birthday audio blocked:",
                error
            );

        });



    /* =====================================================
       START PANO MO NASABI
    ===================================================== */

    panoSound.currentTime = 0;


    panoSound
        .play()
        .catch(error => {

            console.log(
                "Pano sound blocked:",
                error
            );

        });



    /*
    Second Pano overlaps slightly later.

    Maximum unnecessary audio engineering.
    */

    setTimeout(
        () => {

            panoSound2.currentTime = 0;

            panoSound2
                .play()
                .catch(() => {});

        },
        650
    );



    /* =====================================================
       START EVERY SINGLE RONNIE VIDEO
    ===================================================== */

    videos.forEach(video => {


        video.muted = false;


        video
            .play()
            .catch(error => {

                console.log(
                    "Video blocked:",
                    error
                );

            });


    });



    /* =====================================================
       COVER DISAPPEARS
    ===================================================== */

    startScreen
        .classList
        .add("hidden");



    /* =====================================================
       STUPID FLASH
    ===================================================== */

    loadingText.style.display =
        "flex";


    setTimeout(
        () => {

            loadingText.style.display =
                "none";

        },
        650
    );



    /* =====================================================
       CONFETTI
    ===================================================== */

    confettiExplosion();


    setTimeout(
        confettiExplosion,
        400
    );


    setTimeout(
        confettiExplosion,
        900
    );

}



/* =========================================================
   REPLAY MEME SOUNDS RANDOMLY

   After the initial click, Pano Mo Nasabi
   occasionally returns while Ronnie is playing.
========================================================= */

function randomMemeAttack(){


    if(!incidentStarted){
        return;
    }


    const choice =
        Math.floor(
            Math.random() *
            2
        );


    const sound =
        choice === 0
        ?
        panoSound
        :
        panoSound2;


    try{

        sound.currentTime = 0;

        sound
            .play()
            .catch(() => {});

    }

    catch(error){}

}



/*
Random meme attack every 7–13 seconds.
*/

function scheduleMemeAttack(){


    const delay =
        7000 +
        Math.random() *
        6000;


    setTimeout(
        () => {

            randomMemeAttack();

            scheduleMemeAttack();

        },
        delay
    );

}


scheduleMemeAttack();



/* =========================================================
   STICKER JITTER
========================================================= */

const memes =
    document.querySelectorAll(".meme");


setInterval(
    () => {


        memes.forEach(meme => {


            const x =
                Math.random() *
                4 -
                2;


            const y =
                Math.random() *
                4 -
                2;


            meme.style.translate =
                `${x}px ${y}px`;

        });


    },
    280
);



/* =========================================================
   RANDOM PAGE SHAKE
========================================================= */

function pageShake(){


    if(!incidentStarted){
        return;
    }


    document.body.style.transform =
        `translate(
            ${Math.random()*4-2}px,
            ${Math.random()*4-2}px
        )`;


    setTimeout(
        () => {

            document.body.style.transform =
                "translate(0,0)";

        },
        70
    );

}


setInterval(
    pageShake,
    2400
);



/* =========================================================
   CONFETTI
========================================================= */

function confettiExplosion(){


    const colors = [

        "#ffffff",
        "#777777",
        "#bbbbbb",
        "#333333",
        "#dddddd"

    ];


    for(
        let i = 0;
        i < 100;
        i++
    ){


        const piece =
            document.createElement(
                "div"
            );


        piece.className =
            "confetti";


        piece.style.left =
            Math.random() *
            100 +
            "vw";


        piece.style.background =
            colors[
                Math.floor(
                    Math.random() *
                    colors.length
                )
            ];


        piece.style.animationDuration =
            (
                Math.random() *
                3 +
                2
            )
            +
            "s";


        piece.style.animationDelay =
            (
                Math.random() *
                .4
            )
            +
            "s";


        document.body.appendChild(
            piece
        );


        setTimeout(
            () => {

                piece.remove();

            },
            6000
        );

    }

}



/* =========================================================
   PERIODIC CONFETTI
========================================================= */

setInterval(
    () => {


        if(incidentStarted){

            confettiExplosion();

        }


    },
    14000
);

</script>

